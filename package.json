{
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "reselect": "^5.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/register": "^7.28.6",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/babel__core": "^7.20.5",
    "@types/babel__preset-env": "^7.10.0",
    "@types/babel__register": "^7.17.3",
    "@types/node": "^25.2.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/webpack": "^5.28.5",
    "@vitejs/plugin-react": "^5.1.3",
    "babel-loader": "^10.0.0",
    "esbuild": "^0.27.3",
    "esbuild-loader": "^4.4.2",
    "eslint": "^9.39.2",
    "html-webpack-plugin": "^5.6.6",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.2",
    "rollup": "^4.57.1",
    "svg-url-loader": "^8.0.0",
    "terser-webpack-plugin": "^5.3.16",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "webpack": "^5.105.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.3"
  },
  "name": "treeshaking-playground",
  "packageManager": "yarn@4.12.0",
  "scripts": {
    "build:all": "yarn build:esbuild && yarn build:rollup && yarn build:webpack && yarn build:vite",
    "build:altogether": "yarn run clean && tsx esbuild.config.ts && NODE_OPTIONS=--import=tsx rollup -c rollup.config.ts && NODE_OPTIONS=--import=tsx webpack --config webpack.config.ts && vite build",
    "build:esbuild": "yarn run clean && tsx esbuild.config.ts",
    "build:rollup": "rollup --config rollup.config.ts --configPlugin 'typescript={outputToFilesystem:false,'tsconfig':\"tsconfig.build.json\"}'",
    "build:vite": "yarn run clean && vite build",
    "build:webpack": "yarn run clean && NODE_OPTIONS=--import=tsx webpack --config webpack.config.ts",
    "clean": "rimraf dist/",
    "format": "prettier --ignore-path=$PROJECT_CWD/.gitignore --config=$PROJECT_CWD/prettier.config.mts --write $INIT_CWD",
    "format-check": "prettier --ignore-path=$PROJECT_CWD/.gitignore --config=$PROJECT_CWD/prettier.config.mts --check $INIT_CWD",
    "start": "NODE_OPTIONS=--import='tsx/esm' node scripts/everyImport.mts",
    "test": "env ./scripts/everyImport.mts",
    "typecheck": "tsc -p $INIT_CWD/tsconfig.json --noEmit"
  },
  "sideEffects": false,
  "type": "module"
}
