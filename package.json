{
  "name": "treeshaking-playground",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "clean": "rimraf dist",
    "build:esbuild": "yarn clean && tsx esbuild.config.ts",
    "build:rollup": "rollup --config rollup.config.ts --configPlugin 'typescript={outputToFilesystem:false,'tsconfig':\"tsconfig.build.json\"}'",
    "build:webpack": "yarn clean && NODE_OPTIONS=--import=tsx webpack --config webpack.config.ts",
    "build:vite": "yarn clean && vite build",
    "build:all": "yarn build:esbuild && yarn build:rollup && yarn build:webpack && yarn build:vite",
    "build:altogether": "yarn clean && tsx esbuild.config.ts && NODE_OPTIONS=--import=tsx rollup -c rollup.config.ts && NODE_OPTIONS=--import=tsx webpack --config webpack.config.ts && vite build",
    "test": "env ./scripts/everyImport.mts",
    "start": "NODE_OPTIONS=--import='tsx/esm' node scripts/everyImport.mts"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.27.0",
    "@babel/register": "^7.25.9",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/babel__core": "^7.20.5",
    "@types/babel__preset-env": "^7.10.0",
    "@types/babel__register": "^7.17.3",
    "@types/node": "^22.13.14",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@types/webpack": "^5.28.5",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-loader": "^10.0.0",
    "esbuild": "^0.25.1",
    "esbuild-loader": "^4.3.0",
    "eslint": "^9.23.0",
    "html-webpack-plugin": "^5.6.3",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "rollup": "^4.38.0",
    "svg-url-loader": "^8.0.0",
    "terser-webpack-plugin": "^5.3.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0",
    "vite": "^6.2.3",
    "vitest": "^3.0.9",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.1"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.6.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "reselect": "^5.1.1"
  },
  "packageManager": "yarn@4.8.1"
}
